{
  "name": "site-skeleton",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "gate": "node scripts/quality/run-gates.mjs"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.0.0",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "overrides": {
      "next@15.5.21>sharp": "0.35.0",
      "next@15.5.21>postcss": "8.5.12"
    },
    "packageExtensions": {
      "@testing-library/jest-dom@6.9.1": {
        "peerDependencies": {
          "vitest": ">=3 <5"
        },
        "peerDependenciesMeta": {
          "vitest": {
            "optional": true
          }
        }
      }
    }
  }
}
