{
  "hook": "pre-bash-redirect-guard.js",
  "name": "decision reports pattern labels only; the matched secret value is never echoed",
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "echo ghp_0123456789abcdef0123456789abcdef >> .env"
    }
  },
  "expect": {
    "exitCode": 0,
    "permissionDecision": "ask",
    "reasonIncludes": "GitHub",
    "stdoutExcludes": ["ghp_0123456789abcdef0123456789abcdef"]
  }
}
