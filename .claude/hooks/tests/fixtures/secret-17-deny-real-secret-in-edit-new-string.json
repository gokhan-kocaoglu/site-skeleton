{
  "hook": "pre-write-secret-scan.js",
  "name": "Edit new_string is scanned too; decision never echoes the secret value",
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Edit",
    "tool_input": {
      "file_path": "docs/operations/example-runbook.md",
      "old_string": "TOKEN=",
      "new_string": "TOKEN=ghp_FAKEBUTMATCHINGTOKEN123456 <!-- example -->"
    }
  },
  "expect": {
    "exitCode": 0,
    "permissionDecision": "deny",
    "reasonIncludes": "GitHub",
    "stdoutExcludes": ["ghp_FAKEBUTMATCHINGTOKEN123456"]
  }
}
