{
  "hook": "pre-bash-redirect-guard.js",
  "name": "real secret redirected into docs/example.txt still asks",
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "echo ghp_FAKEBUTMATCHINGTOKEN123456 > docs/example.txt"
    }
  },
  "expect": {
