{
  "hook": "pre-write-secret-scan.js",
  "name": "an \"// example\" comment on the same line does not excuse a real token",
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
      "file_path": "apps/web/lib/client.ts",
      "content": "const token = \"ghp_FAKEBUTMATCHINGTOKEN123456\"; // example value\n"
    }
  },
  "expect": {
    "exitCode": 0,
    "permissionDecision": "deny",
    "reasonIncludes": "GitHub"
  }
}
