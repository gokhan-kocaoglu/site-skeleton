{
  "hook": "pre-bash-redirect-guard.js",
  "name": "the word \"dummy\" elsewhere in the command does not excuse a real npm token",
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "echo npm_FAKEBUTMATCHING123456 > dummy-output.txt"
    }
  },
  "expect": {
    "exitCode": 0,
    "permissionDecision": "ask",
    "reasonIncludes": "npm"
  }
}
