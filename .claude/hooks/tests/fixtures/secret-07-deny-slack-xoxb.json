{
  "hook": "pre-write-secret-scan.js",
  "name": "Slack bot token is denied",
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Edit",
    "tool_input": {
      "file_path": "apps/admin/src/notify.ts",
      "old_string": "const slack = '';",
      "new_string": "const slack = 'xoxb-1234567890-987654321098-AbCdEfGhIjKl';"
    }
  },
  "expect": {
    "exitCode": 0,
    "permissionDecision": "deny",
    "reasonIncludes": "Slack"
  }
}
