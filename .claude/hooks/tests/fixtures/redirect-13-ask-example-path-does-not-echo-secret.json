{
  "hook": "pre-bash-redirect-guard.js",
  "name": "decision on an example-named target reports labels only, never the secret value",
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "echo sk_live_FAKE12345678 > docs/example-config.json"
    }
  },
  "expect": {
    "exitCode": 0,
    "permissionDecision": "ask",
    "reasonIncludes": "Stripe",
    "stdoutExcludes": ["sk_live_FAKE12345678"]
  }
}
