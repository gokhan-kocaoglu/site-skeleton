{
  "hook": "pre-write-secret-scan.js",
  "name": "GitHub token is denied",
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
      "file_path": "apps/api/src/main/resources/application.yml",
      "content": "token: ghp_0123456789abcdef0123456789abcdef\n"
    }
  },
  "expect": {
    "exitCode": 0,
    "permissionDecision": "deny",
    "reasonIncludes": "GitHub"
  }
}
