{
  "hook": "pre-write-secret-scan.js",
  "name": "a real secret is denied even when the target file is named .env.example",
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
      "file_path": "apps/web/.env.example",
      "content": "STRIPE_SECRET_KEY=sk_live_FAKE12345678\n"
    }
  },
  "expect": {
    "exitCode": 0,
    "permissionDecision": "deny",
    "reasonIncludes": "Stripe"
  }
}
