{
  "hook": "pre-write-secret-scan.js",
  "name": "npm token is denied",
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
      "file_path": ".npmrc",
      "content": "//registry.npmjs.org/:_authToken=npm_abcdEFGH1234ijkl5678\n"
    }
  },
  "expect": {
    "exitCode": 0,
    "permissionDecision": "deny",
    "reasonIncludes": "npm"
  }
}
