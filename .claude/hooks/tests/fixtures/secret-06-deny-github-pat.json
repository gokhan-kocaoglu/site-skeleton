{
  "hook": "pre-write-secret-scan.js",
  "name": "GitHub fine-grained PAT is denied",
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
      "file_path": "apps/web/lib/api.ts",
      "content": "const token = 'github_pat_11ABCDEFG0abcdefghijklmnopqrstuv';\n"
