{
  "hook": "pre-write-secret-scan.js",
  "name": ".env.example placeholders are legal",
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
      "file_path": ".env.example",
      "content": "DB_PASSWORD=PLACEHOLDER\nJWT_SECRET=CHANGE_ME\nOPENAI_API_KEY=<your-key-here>\n"
    }
  },
  "expect": {
    "exitCode": 0,
    "noStdout": true
  }
}
