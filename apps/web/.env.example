# Public origin of the deployed site: scheme + host, no trailing slash, no path.
# REQUIRED for production builds (`next build`): canonical, sitemap, robots and
# Open Graph URLs are frozen into the static output at build time; when this is
# missing the build FAILS FAST (guard: apps/web/lib/site-url.ts) instead of
# silently publishing localhost URLs. Dev/test fall back to localhost:3000.
# Copy this file to .env.local and set the real origin.
NEXT_PUBLIC_SITE_URL=https://example.com
