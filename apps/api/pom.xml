<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.skeleton</groupId>
  <artifactId>api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>skeleton-api</name>
  <description>Skeleton API — Spring Boot backend (not part of the pnpm workspace)</description>

  <properties>
    <java.version>21</java.version>
    <!-- Docker Engine 29+ requires Testcontainers >= 1.21.4 (min API 1.44 →
         npipe 400). Testcontainers stays BOM-managed: Boot 4.1 imports
         testcontainers-bom 2.0.5 (verified via dependency:tree in the Faz 8.3
         evidence report); if a future BOM downgrade ever lands below 1.21.4,
         re-pin here. -->
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Boot 4 modular starters: Flyway auto-configuration ships in its own
         starter; the postgres dialect module is still added alongside it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Boot 4 technology-specific test starter (brings spring-boot-starter-test
         and spring-boot-resttestclient transitively; verified via dependency:tree). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- TestRestTemplate auto-configuration introspects RestTemplateBuilder
         (org.springframework.boot.restclient), which webmvc-test does NOT pull
         in. Test scope only: production code has no RestTemplate usage, so the
         runtime classpath must not grow (Faz 8.3 PR-A1 condition 1). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers 2.x renamed all modules with a testcontainers- prefix
         (Boot 4.1 BOM imports testcontainers-bom 2.0.5). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Integration tests (*IT.java) run in the verify phase. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      it-local: run integration tests against a local PostgreSQL 16 instead of
      Testcontainers (for machines without Docker). Requires an empty database:
        CREATE DATABASE skeleton_it;
      Usage: mvn verify -Pit-local
      Credentials default to postgres/postgres; override via IT_DB_USER / IT_DB_PASSWORD.
    -->
    <profile>
      <id>it-local</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <it.local>true</it.local>
                <spring.profiles.active>it-local</spring.profiles.active>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
